{
  "name": "signal-chain",
  "version": "0.2.0",
  "description": "A native desktop patch editor for the Zoom MS Plus pedal series and Bass Pod/Pro",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "web": "python3 web/serve.py",
    "test": "node --test test/",
    "icons": "python3 scripts/generate-icons.py",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win"
  },
  "author": "Nathaniel Reynolds",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:bassmannate/zoom-plus.git"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.github.bassmannate.signal-chain",
    "productName": "Signal Chain",
    "copyright": "Copyright © 2026 Nathaniel Reynolds",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "shared/**/*",
      "LICENSE.md",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "linux": {
      "target": ["AppImage"],
      "category": "AudioVideo",
      "icon": "assets/icon.png",
      "executableName": "signal-chain",
      "artifactName": "Signal-Chain-${version}-linux.${ext}"
    },
    "win": {
      "target": ["nsis"],
      "icon": "assets/icon.ico",
      "executableName": "signal-chain",
      "artifactName": "Signal-Chain-${version}-win.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Signal Chain"
    }
  }
}
